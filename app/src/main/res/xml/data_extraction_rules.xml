<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="trackwell.db"/>
        <include domain="database" path="trackwell.db-wal"/>
        <include domain="database" path="trackwell.db-shm"/>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="datastore/"/>
        <include domain="external" path="GoogleDriveBackups/"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="."/>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="."/>
    </device-transfer>
</data-extraction-rules>
